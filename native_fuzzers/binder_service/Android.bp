/**
 * AOSP Build Blueprint for the SurfaceFlinger Binder Fuzzer.
 *
 * Build: lunch aosp_cf_x86_64-userdebug && m surface_flinger_fuzzer
 */
cc_fuzz {
    name: "surface_flinger_fuzzer",
    host_supported: false,
    device_supported: true,

    srcs: [
        "surface_flinger_fuzzer.cpp",
    ],

    // service_fuzzer_defaults provides the fuzzService() driver
    // (libbinder_random_parcel) plus libbase/libcutils and the binder libs.
    defaults: [
        "service_fuzzer_defaults",
    ],

    shared_libs: [
        "liblog",
    ],

    fuzz_config: {
        cc: [
            "android-security@google.com",
        ],
        componentid: 1075131, // Framework Window / SurfaceFlinger
        description: "Fuzzes SurfaceFlinger Binder endpoints via AOSP fuzzService framework",
        vector: "local_privileged",
        service_privilege: "system",
    },

    sanitize: {
        hwaddress: true,
        address: true,
    },
}
