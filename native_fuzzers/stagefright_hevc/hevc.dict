# HEVC (H.265) libFuzzer Token Dictionary
# Start Codes
nal_prefix_3="\x00\x00\x01"
nal_prefix_4="\x00\x00\x00\x01"

# NAL Unit Types (NAL_UNIT_HEADER)
nal_vps="\x40\x01" # VPS: nal_unit_type = 32
nal_sps="\x42\x01" # SPS: nal_unit_type = 33
nal_pps="\x44\x01" # PPS: nal_unit_type = 34
nal_aud="\x46\x01" # Access Unit Delimiter: nal_unit_type = 35
nal_idr_w_radl="\x26\x01" # IDR_W_RADL: nal_unit_type = 19
nal_idr_n_lp="\x28\x01"   # IDR_N_LP: nal_unit_type = 20
nal_cra="\x2A\x01"        # CRA_NUT: nal_unit_type = 21
nal_trail_r="\x02\x01"    # TRAIL_R: nal_unit_type = 1

# Slice Header Tokens & Boundary Markers
slice_header_boundary="\xFF\xFE"
slice_end="\x80\x00"
emulation_prevention_three_byte="\x00\x00\x03"
